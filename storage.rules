rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSmallUpload() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024;
    }

    function isImageUpload() {
      return isSmallUpload()
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/.*');
    }

    match /tcg_shop_submissions/{userId}/{submissionId}/{fileName} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isSmallUpload();

      allow delete: if signedIn()
        && request.auth.uid == userId;
    }

    match /business_profiles/{allPaths=**} {
      allow read: if true;

      allow create, update: if signedIn()
        && isSmallUpload();

      allow delete: if signedIn();
    }

    /*
      TEMPORARY SAFE TEST FALLBACK

      This lets signed-in users upload small files only.
      It helps fix/diagnose Firebase Storage path mismatches while testing.
      Once the exact upload path is confirmed, this can be tightened again.
    */
    match /{allPaths=**} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && isSmallUpload();

      allow delete: if signedIn();
    }
  }
}
