rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    function roleDoc(uid) {
      return get(/databases/$(database)/documents/app_roles/$(uid));
    }

    function roleExists(uid) {
      return exists(/databases/$(database)/documents/app_roles/$(uid));
    }

    function hasRole(uid, allowedRoles) {
      return signedIn()
        && roleExists(uid)
        && roleDoc(uid).data.role in allowedRoles;
    }

    function isAdmin() {
      return signedIn() && hasRole(request.auth.uid, ['admin']);
    }

    function isAdminOrModerator() {
      return signedIn() && hasRole(request.auth.uid, ['admin', 'moderator']);
    }

    function restockAlertsEnabledFor(uid) {
      return exists(/databases/$(database)/documents/user_feature_flags/$(uid))
        && get(/databases/$(database)/documents/user_feature_flags/$(uid)).data.restockAlertsEnabled == true;
    }

    function hasDob(uid) {
      return userExists(uid) && userDoc(uid).data.dateOfBirthMs is int;
    }

    function dobDate(uid) {
      return timestamp.value(userDoc(uid).data.dateOfBirthMs).date();
    }

    function isAdult(uid) {
      return hasDob(uid) && (
        (request.time.date().year() - dobDate(uid).year()) > 18 ||
        (
          (request.time.date().year() - dobDate(uid).year()) == 18 &&
          (
            request.time.date().month() > dobDate(uid).month() ||
            (
              request.time.date().month() == dobDate(uid).month() &&
              request.time.date().day() >= dobDate(uid).day()
            )
          )
        )
      );
    }

    function canUseCommunity() {
      return signedIn() && isAdult(request.auth.uid);
    }

    function areFriends(viewerUid, ownerUid) {
      return
        exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(viewerUid)) &&
        exists(/databases/$(database)/documents/users/$(viewerUid)/friends/$(ownerUid));
    }

    function canViewSharedCollection(ownerUid) {
      return signedIn() &&
        (request.auth.uid == ownerUid || areFriends(request.auth.uid, ownerUid));
    }

    function friendRequestExists(fromUid, toUid) {
      return exists(/databases/$(database)/documents/friend_requests/$(fromUid + "_to_" + toUid));
    }

    function friendRequestDoc(fromUid, toUid) {
      return get(/databases/$(database)/documents/friend_requests/$(fromUid + "_to_" + toUid));
    }

    function pendingFriendRequestExists(fromUid, toUid) {
      return friendRequestExists(fromUid, toUid) &&
        friendRequestDoc(fromUid, toUid).data.status == "pending";
    }

    function acceptedFriendRequestExists(fromUid, toUid) {
      return friendRequestExists(fromUid, toUid) &&
        friendRequestDoc(fromUid, toUid).data.status == "accepted";
    }

    function hasPendingFriendRequestBetween(uidA, uidB) {
      return pendingFriendRequestExists(uidA, uidB) ||
        pendingFriendRequestExists(uidB, uidA);
    }

    function hasAcceptedFriendRequestBetween(uidA, uidB) {
      return acceptedFriendRequestExists(uidA, uidB) ||
        acceptedFriendRequestExists(uidB, uidA);
    }

    function pendingRequestRecipientIsCurrentUser(uidA, uidB) {
      return
        (
          pendingFriendRequestExists(uidA, uidB) &&
          friendRequestDoc(uidA, uidB).data.toUid == request.auth.uid
        ) ||
        (
          pendingFriendRequestExists(uidB, uidA) &&
          friendRequestDoc(uidB, uidA).data.toUid == request.auth.uid
        );
    }

    function canCreateFriendDoc(userId, friendUid) {
      return signedIn() &&
        userExists(userId) &&
        userExists(friendUid) &&
        (
          pendingRequestRecipientIsCurrentUser(userId, friendUid) ||
          (
            hasAcceptedFriendRequestBetween(userId, friendUid) &&
            (request.auth.uid == userId || request.auth.uid == friendUid)
          )
        );
    }

    function twoAdultParticipants(participants) {
      return participants is list &&
        participants.size() == 2 &&
        isAdult(participants[0]) &&
        isAdult(participants[1]);
    }

    function validPrivateConversationData(data) {
      return data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && data.participantNames is map
        && data.relatedPostId is string
        && data.relatedPostTitle is string
        && data.createdAtMs is int
        && data.updatedAtMs is int
        && data.lastMessage is string
        && data.lastSenderId is string
        && twoAdultParticipants(data.participants);
    }

    function validPrivateMirrorConversationData(data, userId) {
      return data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && userId in data.participants
        && data.participantNames is map
        && data.relatedPostId is string
        && data.relatedPostTitle is string
        && data.createdAtMs is int
        && data.updatedAtMs is int
        && data.lastMessage is string
        && data.lastSenderId is string;
    }

    function validPrivateMessageData(data) {
      return data.authorId == request.auth.uid
        && data.authorName is string
        && data.message is string
        && data.createdAtMs is int;
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function validChatData(data) {
      return data.keys().hasOnly([
          'participants',
          'lastMessage',
          'updatedAt'
        ])
        && data.participants is list
        && data.participants.size() == 2
        && request.auth.uid in data.participants
        && data.lastMessage is string
        && data.updatedAt is timestamp
        && twoAdultParticipants(data.participants);
    }

    function validChatMessageData(data) {
      return data.keys().hasOnly([
          'senderId',
          'text',
          'createdAt'
        ])
        && data.senderId == request.auth.uid
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function validCustomBinderData(data, binderId) {
      return data.keys().hasOnly([
          'id',
          'name',
          'createdAtMs',
          'updatedAtMs',
          'imageRef',
          'imageUrl',
          'imageBase64'
        ])
        && data.id == binderId
        && data.name is string
        && data.createdAtMs is int
        && data.updatedAtMs is int
        && (!('imageRef' in data) || data.imageRef is string)
        && (!('imageUrl' in data) || data.imageUrl is string)
        && (!('imageBase64' in data) || data.imageBase64 is string);
    }

    function validCustomBinderCardData(data, cardId) {
      return data.keys().hasOnly([
          'cardId',
          'name',
          'setId',
          'setName',
          'number',
          'imageUrl',
          'largeImageUrl',
          'setLogoUrl',
          'normal',
          'reverseHolo',
          'holo',
          'copies',
          'condition',
          'gradingCompany',
          'grade',
          'conditionNotes',
          'updatedAtMs'
        ])
        && data.cardId == cardId
        && data.name is string
        && data.setId is string
        && data.setName is string
        && data.number is string
        && (!('imageUrl' in data) || data.imageUrl is string)
        && (!('largeImageUrl' in data) || data.largeImageUrl is string)
        && (!('setLogoUrl' in data) || data.setLogoUrl is string)
        && data.normal is bool
        && data.reverseHolo is bool
        && data.holo is bool
        && data.copies is int
        && data.copies >= 1
        && (!('condition' in data) || data.condition is string)
        && (!('gradingCompany' in data) || data.gradingCompany is string)
        && (!('grade' in data) || data.grade is number)
        && (!('conditionNotes' in data) || (data.conditionNotes is string && data.conditionNotes.size() <= 300))
        && data.updatedAtMs is int;
    }

    function validBlockedUserData(data, userId, blockedUid) {
      return data.keys().hasOnly([
          'blockedUid',
          'blockedName',
          'blockedByUid',
          'blockedByName',
          'source',
          'createdAtMs',
          'updatedAtMs'
        ])
        && data.blockedUid == blockedUid
        && data.blockedByUid == userId
        && data.blockedByUid == request.auth.uid
        && data.blockedUid != request.auth.uid
        && data.blockedName is string
        && data.blockedByName is string
        && data.source is string
        && data.createdAtMs is int
        && data.updatedAtMs is int;
    }

    function validCommunityReportData(data) {
      return data.keys().hasOnly([
          'reporterUid',
          'reporterName',
          'reportedUid',
          'reportedName',
          'targetType',
          'targetId',
          'targetTitle',
          'reason',
          'details',
          'status',
          'appArea',
          'createdAtMs',
          'updatedAtMs'
        ])
        && data.reporterUid == request.auth.uid
        && data.reporterName is string
        && data.reportedUid is string
        && (data.reportedUid == '' || data.reportedUid != request.auth.uid)
        && data.reportedName is string
        && data.targetType is string
        && data.targetId is string
        && data.targetTitle is string
        && data.reason is string
        && data.details is string
        && data.details.size() <= 1500
        && data.status == 'open'
        && data.appArea == 'community'
        && data.createdAtMs is int
        && data.updatedAtMs is int;
    }

    function validFcmTokenData(data, userId) {
      return data.keys().hasOnly([
          'token',
          'platform',
          'app',
          'userId',
          'updatedAt'
        ])
        && data.token is string
        && data.platform is string
        && data.app == 'PocketChase'
        && data.userId == userId
        && data.updatedAt is timestamp;
    }

    function validRestockAlertData(data) {
      return data.keys().hasOnly([
          'shopName',
          'productName',
          'productUrl',
          'imageUrl',
          'notes',
          'inStock',
          'createdAt',
          'updatedAt',
          'createdByUid',
          'createdByName'
        ])
        && data.shopName is string
        && data.productName is string
        && data.productUrl is string
        && data.imageUrl is string
        && data.notes is string
        && data.inStock is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdByUid == request.auth.uid
        && data.createdByName is string;
    }

    function validTrackedRestockProductData(data) {
      return data.keys().hasOnly([
          'shopName',
          'productName',
          'productUrl',
          'imageUrl',
          'notes',
          'enabled',
          'inStock',
          'region',
          'storeName',
          'storeId',
          'storeAddress',
          'inStockKeywords',
          'outOfStockKeywords',
          'createdAt',
          'updatedAt',
          'createdByUid',
          'lastCheckedAt',
          'lastAlertedAt',
          'lastCheckStatus',
          'lastCheckError'
        ])
        && data.shopName is string
        && data.productName is string
        && data.productUrl is string
        && data.imageUrl is string
        && data.notes is string
        && data.enabled is bool
        && data.inStock is bool
        && data.region is string
        && data.storeName is string
        && data.storeId is string
        && data.storeAddress is string
        && data.inStockKeywords is list
        && data.inStockKeywords.size() <= 30
        && data.outOfStockKeywords is list
        && data.outOfStockKeywords.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdByUid == request.auth.uid
        && (!('lastCheckedAt' in data) || data.lastCheckedAt == null || data.lastCheckedAt is timestamp)
        && (!('lastAlertedAt' in data) || data.lastAlertedAt == null || data.lastAlertedAt is timestamp)
        && data.lastCheckStatus is string
        && data.lastCheckError is string;
    }

    function validUserTrackedRestockProductData(data, userId) {
      return data.keys().hasOnly([
          'userId',
          'shopName',
          'productName',
          'productUrl',
          'imageUrl',
          'notes',
          'enabled',
          'inStock',
          'region',
          'storeName',
          'storeId',
          'storeAddress',
          'inStockKeywords',
          'outOfStockKeywords',
          'createdAt',
          'updatedAt',
          'lastCheckedAt',
          'lastAlertedAt',
          'lastCheckStatus',
          'lastCheckError'
        ])
        && data.userId == userId
        && data.shopName is string
        && data.productName is string
        && data.productUrl is string
        && data.imageUrl is string
        && data.notes is string
        && data.enabled is bool
        && data.inStock is bool
        && data.region is string
        && data.storeName is string
        && data.storeId is string
        && data.storeAddress is string
        && data.inStockKeywords is list
        && data.inStockKeywords.size() <= 30
        && data.outOfStockKeywords is list
        && data.outOfStockKeywords.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastCheckedAt' in data) || data.lastCheckedAt == null || data.lastCheckedAt is timestamp)
        && (!('lastAlertedAt' in data) || data.lastAlertedAt == null || data.lastAlertedAt is timestamp)
        && data.lastCheckStatus is string
        && data.lastCheckError is string;
    }

    function validUserRestockAlertPreferencesData(data, userId) {
      return data.keys().hasOnly([
          'userId',
          'enabled',
          'selectedShops',
          'selectedRegions',
          'selectedStoreIds',
          'updatedAt'
        ])
        && data.userId == userId
        && data.enabled is bool
        && data.selectedShops is list
        && data.selectedShops.size() <= 100
        && data.selectedRegions is list
        && data.selectedRegions.size() <= 200
        && data.selectedStoreIds is list
        && data.selectedStoreIds.size() <= 500
        && data.updatedAt is timestamp
        && userExists(userId);
    }

    function validAppRoleData(data, userId) {
      return data.keys().hasOnly([
          'uid',
          'role',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && data.uid == userId
        && data.role in ['admin', 'moderator']
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('updatedBy' in data) || data.updatedBy is string);
    }

    function validUserFeatureFlagsData(data, userId) {
      return data.keys().hasOnly([
          'userId',
          'restockAlertsEnabled',
          'proEnabled',
          'updatedAt',
          'updatedBy'
        ])
        && data.userId == userId
        && data.restockAlertsEnabled is bool
        && data.proEnabled is bool
        && data.updatedAt is timestamp
        && data.updatedBy is string
        && userExists(userId);
    }

    function communityFeaturedPostFields() {
      return [
        'featuredByUser',
        'featuredByUserId',
        'featuredByUserAtMs',
        'featuredByAdmin',
        'featuredByAdminUid',
        'featuredByAdminAtMs'
      ];
    }

    function communityCreateHasNoFeaturedFields() {
      return !request.resource.data.keys().hasAny(communityFeaturedPostFields());
    }

    function communityFeaturedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(communityFeaturedPostFields());
    }

    function validTcgShopSubmissionCreateData(data) {
      return data.keys().hasOnly([
          'name',
          'nameLower',
          'address',
          'town',
          'townLower',
          'county',
          'countyLower',
          'country',
          'postcode',
          'postcodeLower',
          'lat',
          'lng',
          'location',
          'games',
          'services',
          'website',
          'phone',
          'imageUrl',
          'imagePath',
          'status',
          'submittedBy',
          'submittedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.nameLower is string
        && data.address is string
        && data.address.size() <= 300
        && data.town is string
        && data.town.size() <= 120
        && data.townLower is string
        && data.county is string
        && data.county.size() <= 120
        && data.countyLower is string
        && data.country is string
        && data.country.size() <= 120
        && data.postcode is string
        && data.postcode.size() <= 30
        && data.postcodeLower is string
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.location is latlng
        && data.games is list
        && data.games.size() <= 20
        && data.services is list
        && data.services.size() <= 30
        && data.website is string
        && data.website.size() <= 300
        && data.phone is string
        && data.phone.size() <= 40
        && data.imageUrl is string
        && data.imageUrl.size() <= 1000
        && data.imagePath is string
        && data.imagePath.size() <= 1000
        && data.status == 'pending'
        && data.submittedBy == request.auth.uid
        && data.submittedByEmail is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTcgShopData(data) {
      return data.keys().hasOnly([
          'name',
          'nameLower',
          'address',
          'town',
          'townLower',
          'county',
          'countyLower',
          'country',
          'postcode',
          'postcodeLower',
          'lat',
          'lng',
          'location',
          'games',
          'services',
          'website',
          'phone',
          'imageUrl',
          'imagePath',
          'status',
          'submittedBy',
          'submittedByEmail',
          'approvedBy',
          'approvedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.nameLower is string
        && data.address is string
        && data.address.size() <= 300
        && data.town is string
        && data.town.size() <= 120
        && data.townLower is string
        && data.county is string
        && data.county.size() <= 120
        && data.countyLower is string
        && data.country is string
        && data.country.size() <= 120
        && data.postcode is string
        && data.postcode.size() <= 30
        && data.postcodeLower is string
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.location is latlng
        && data.games is list
        && data.games.size() <= 20
        && data.services is list
        && data.services.size() <= 30
        && data.website is string
        && data.website.size() <= 300
        && data.phone is string
        && data.phone.size() <= 40
        && data.imageUrl is string
        && data.imageUrl.size() <= 1000
        && data.imagePath is string
        && data.imagePath.size() <= 1000
        && data.status in ['approved', 'pending', 'rejected']
        && data.submittedBy is string
        && data.submittedByEmail is string
        && (!('approvedBy' in data) || data.approvedBy is string)
        && (!('approvedAt' in data) || data.approvedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validBusinessProfileData(data) {
      return data.keys().hasOnly([
          'ownerUid',
          'ownerEmail',
          'businessName',
          'businessNameLower',
          'description',
          'linkedShopId',
          'linkedShopName',
          'hasPhysicalShop',
          'website',
          'phone',
          'town',
          'townLower',
          'county',
          'countyLower',
          'logoUrl',
          'bannerUrl',
          'status',
          'verified',
          'premiumActive',
          'premiumExpiresAt',
          'premiumSource',
          'featuredShopEnabled',
          'autoFeaturePosts',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && data.ownerUid is string
        && data.ownerEmail is string
        && data.businessName is string
        && data.businessName.size() > 0
        && data.businessName.size() <= 120
        && data.businessNameLower is string
        && data.description is string
        && data.description.size() <= 500
        && data.linkedShopId is string
        && data.linkedShopId.size() <= 120
        && data.linkedShopName is string
        && data.linkedShopName.size() <= 120
        && (!('hasPhysicalShop' in data) || data.hasPhysicalShop is bool)
        && (
          !('hasPhysicalShop' in data) ||
          data.hasPhysicalShop == false ||
          (data.linkedShopId.size() > 0 && data.linkedShopName.size() > 0)
        )
        && data.website is string
        && data.website.size() <= 300
        && data.phone is string
        && data.phone.size() <= 40
        && data.town is string
        && data.town.size() <= 120
        && data.townLower is string
        && data.county is string
        && data.county.size() <= 120
        && data.countyLower is string
        && data.logoUrl is string
        && data.logoUrl.size() <= 1000
        && data.bannerUrl is string
        && data.bannerUrl.size() <= 1000
        && data.status in ['pending', 'approved', 'rejected']
        && data.verified is bool
        && data.premiumActive is bool
        && (!('premiumExpiresAt' in data) || data.premiumExpiresAt == null || data.premiumExpiresAt is timestamp)
        && data.premiumSource is string
        && data.featuredShopEnabled is bool
        && data.autoFeaturePosts is bool
        && (!('updatedBy' in data) || data.updatedBy is string);
    }





    function validBusinessAnalyticsSummaryData(data) {
      return data.keys().hasOnly([
          'profileViews',
          'websiteClicks',
          'phoneClicks',
          'mapViews',
          'offerViews',
          'eventViews',
          'updatedAt'
        ])
        && (!('profileViews' in data) || data.profileViews is int)
        && (!('websiteClicks' in data) || data.websiteClicks is int)
        && (!('phoneClicks' in data) || data.phoneClicks is int)
        && (!('mapViews' in data) || data.mapViews is int)
        && (!('offerViews' in data) || data.offerViews is int)
        && (!('eventViews' in data) || data.eventViews is int)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function validBusinessEventData(data, businessId) {
      return data.keys().hasOnly([
          'businessId',
          'businessName',
          'ownerUid',
          'title',
          'description',
          'eventType',
          'location',
          'onlineEvent',
          'entryFee',
          'bookingUrl',
          'active',
          'startsAt',
          'endsAt',
          'createdAt',
          'updatedAt'
        ])
        && data.businessId == businessId
        && data.businessName is string
        && data.businessName.size() <= 120
        && data.ownerUid is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 90
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 700
        && data.eventType in ['trade_night', 'tournament', 'pre_release', 'release_day', 'giveaway', 'meetup', 'other']
        && data.location is string
        && data.location.size() <= 180
        && data.onlineEvent is bool
        && (data.onlineEvent == true || data.location.size() > 0)
        && data.entryFee is string
        && data.entryFee.size() <= 80
        && data.bookingUrl is string
        && data.bookingUrl.size() <= 300
        && data.active is bool
        && data.startsAt is timestamp
        && (data.endsAt == null || data.endsAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validBusinessOfferData(data, businessId) {
      return data.keys().hasOnly([
          'businessId',
          'businessName',
          'ownerUid',
          'title',
          'description',
          'category',
          'code',
          'websiteUrl',
          'active',
          'startsAt',
          'endsAt',
          'createdAt',
          'updatedAt'
        ])
        && data.businessId == businessId
        && data.businessName is string
        && data.businessName.size() <= 120
        && data.ownerUid is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 90
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 500
        && data.category in ['discount', 'new_stock', 'event', 'announcement']
        && data.code is string
        && data.code.size() <= 40
        && data.websiteUrl is string
        && data.websiteUrl.size() <= 300
        && data.active is bool
        && (data.startsAt == null || data.startsAt is timestamp)
        && (data.endsAt == null || data.endsAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validBusinessReviewData(data, businessId) {
      return data.keys().hasOnly([
          'businessId',
          'businessName',
          'reviewerUid',
          'reviewerName',
          'stars',
          'comment',
          'businessReply',
          'businessReplyByUid',
          'businessReplyCreatedAt',
          'businessReplyUpdatedAt',
          'createdAt',
          'updatedAt'
        ])
        && data.businessId == businessId
        && data.businessName is string
        && data.businessName.size() <= 120
        && data.reviewerUid is string
        && data.reviewerName is string
        && data.reviewerName.size() <= 120
        && data.stars is int
        && data.stars >= 1
        && data.stars <= 5
        && data.comment is string
        && data.comment.size() > 0
        && data.comment.size() <= 500
        && (!('businessReply' in data) || data.businessReply is string)
        && (!('businessReply' in data) || data.businessReply.size() <= 500)
        && (!('businessReplyByUid' in data) || data.businessReplyByUid is string)
        && (!('businessReplyCreatedAt' in data) || data.businessReplyCreatedAt == null || data.businessReplyCreatedAt is timestamp)
        && (!('businessReplyUpdatedAt' in data) || data.businessReplyUpdatedAt == null || data.businessReplyUpdatedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownerBusinessFieldsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          'ownerUid',
          'ownerEmail',
          'status',
          'verified',
          'premiumActive',
          'premiumExpiresAt',
          'premiumSource',
          'featuredShopEnabled',
          'autoFeaturePosts',
          'createdAt',
          'updatedBy'
        ]);
    }

    match /app_roles/{userId} {
      allow read: if isSelf(userId) || isAdminOrModerator();

      allow create, update: if isAdmin()
        && validAppRoleData(request.resource.data, userId);

      allow delete: if isAdmin();
    }

    match /user_feature_flags/{userId} {
      allow read: if isSelf(userId) || isAdminOrModerator();

      allow create, update: if isAdminOrModerator()
        && request.resource.data.userId == userId
        && request.resource.data.restockAlertsEnabled is bool
        && request.resource.data.proEnabled is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy is string
        && userExists(userId);

      allow delete: if isAdmin();
    }

    match /tcg_shops/{shopId} {
      // Public map data. Anyone can read shop pins.
      // Submissions are still kept private in tcg_shop_submissions until approved.
      allow read: if true;

      allow create, update: if isAdminOrModerator()
        && validTcgShopData(request.resource.data);

      allow delete: if isAdminOrModerator();
    }

    match /tcg_shop_submissions/{submissionId} {
      allow create: if signedIn()
        && validTcgShopSubmissionCreateData(request.resource.data);

      allow read: if signedIn()
        && (
          resource.data.submittedBy == request.auth.uid ||
          isAdminOrModerator()
        );

      allow update, delete: if isAdminOrModerator();
    }

    match /business_profiles/{businessId} {
      // Public read allows featured shop badges/markers to load on the map.
      allow read: if true;

      // A signed-in user can create their own business profile, but cannot
      // approve it or give themselves premium features.
      allow create: if signedIn()
        && (
          isAdminOrModerator() ||
          (
            userExists(request.auth.uid) &&
            userDoc(request.auth.uid).data.accountType == 'business'
          )
        )
        && validBusinessProfileData(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.hasPhysicalShop is bool
        && request.resource.data.status == 'approved'
        && request.resource.data.verified == false
        && request.resource.data.premiumActive == false
        && request.resource.data.premiumExpiresAt == null
        && request.resource.data.premiumSource == ''
        && request.resource.data.featuredShopEnabled == false
        && request.resource.data.autoFeaturePosts == false;

      // Owners can edit normal business details only.
      // Admins/moderators can approve, verify, and switch premium flags on/off.
      allow update: if (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && validBusinessProfileData(request.resource.data)
          && ownerBusinessFieldsUnchanged()
        ) || (
          isAdminOrModerator()
          && validBusinessProfileData(request.resource.data)
        );

      // Business owners can delete their own profile. Admins/moderators can delete any business profile.
      allow delete: if isAdminOrModerator()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);




      match /analytics/{analyticsId} {
        allow read: if analyticsId == 'summary'
          && (
            isAdminOrModerator() ||
            (
              signedIn()
              && exists(/databases/$(database)/documents/business_profiles/$(businessId))
              && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
            )
          );

        allow create, update: if analyticsId == 'summary'
          && signedIn()
          && validBusinessAnalyticsSummaryData(request.resource.data);

        allow delete: if analyticsId == 'summary' && isAdminOrModerator();
      }

      match /events/{eventId} {
        allow read: if true;

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && (
            isAdminOrModerator() ||
            (
              get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
              && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.premiumActive == true
            )
          )
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid
          && validBusinessEventData(request.resource.data, businessId);

        allow update: if signedIn()
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && (
            isAdminOrModerator() ||
            (
              get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
              && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.premiumActive == true
            )
          )
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && validBusinessEventData(request.resource.data, businessId);

        allow delete: if isAdminOrModerator()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/business_profiles/$(businessId))
            && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
          );
      }

      match /offers/{offerId} {
        allow read: if true;

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && (
            isAdminOrModerator() ||
            (
              get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
              && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.premiumActive == true
            )
          )
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid
          && validBusinessOfferData(request.resource.data, businessId);

        allow update: if signedIn()
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && (
            isAdminOrModerator() ||
            (
              get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
              && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.premiumActive == true
            )
          )
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && validBusinessOfferData(request.resource.data, businessId);

        allow delete: if isAdminOrModerator()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/business_profiles/$(businessId))
            && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
          );
      }

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.resource.data.reviewerUid == request.auth.uid
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid != request.auth.uid
          && validBusinessReviewData(request.resource.data, businessId);

        // Review writers can edit their own review, but cannot edit the business reply fields.
        allow update: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.reviewerUid == request.auth.uid
          && request.resource.data.reviewerUid == resource.data.reviewerUid
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.businessName is string
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.businessReply == resource.data.businessReply
          && request.resource.data.businessReplyByUid == resource.data.businessReplyByUid
          && request.resource.data.businessReplyCreatedAt == resource.data.businessReplyCreatedAt
          && request.resource.data.businessReplyUpdatedAt == resource.data.businessReplyUpdatedAt
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid != request.auth.uid
          && validBusinessReviewData(request.resource.data, businessId);

        // Business owners/admins can only edit the business reply fields.
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/business_profiles/$(businessId))
          && (
            isAdminOrModerator() ||
            get(/databases/$(database)/documents/business_profiles/$(businessId)).data.ownerUid == request.auth.uid
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'businessReply',
            'businessReplyByUid',
            'businessReplyCreatedAt',
            'businessReplyUpdatedAt'
          ])
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.businessName == resource.data.businessName
          && request.resource.data.reviewerUid == resource.data.reviewerUid
          && request.resource.data.reviewerName == resource.data.reviewerName
          && request.resource.data.stars == resource.data.stars
          && request.resource.data.comment == resource.data.comment
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == resource.data.updatedAt
          && validBusinessReviewData(request.resource.data, businessId);

        allow delete: if isAdminOrModerator()
          || (
            signedIn()
            && reviewId == request.auth.uid
            && resource.data.reviewerUid == request.auth.uid
          );
      }
    }

    match /restock_alerts/{alertId} {
      allow read: if signedIn()
        && (restockAlertsEnabledFor(request.auth.uid) || isAdminOrModerator());

      allow create, update: if isAdminOrModerator()
        && validRestockAlertData(request.resource.data);

      allow delete: if isAdminOrModerator();
    }

    match /tracked_restock_products/{productId} {
      allow read: if isAdminOrModerator();

      allow create, update: if isAdminOrModerator()
        && request.resource.data.shopName is string
        && request.resource.data.productName is string
        && request.resource.data.productUrl is string
        && request.resource.data.enabled is bool
        && request.resource.data.inStock is bool;

      allow delete: if isAdminOrModerator();
    }

    match /user_restock_alert_preferences/{userId} {
      allow read: if isSelf(userId) || isAdminOrModerator();

      allow create, update: if isSelf(userId)
        && validUserRestockAlertPreferencesData(request.resource.data, userId);

      allow delete: if isSelf(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && (!('dateOfBirthMs' in request.resource.data) || request.resource.data.dateOfBirthMs is int)
        && (!('accountType' in request.resource.data) || request.resource.data.accountType in ['personal', 'business'])
        && (!('businessProfileCreated' in request.resource.data) || request.resource.data.businessProfileCreated is bool);

      allow update: if isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.username is string
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && (!('dateOfBirthMs' in request.resource.data) || request.resource.data.dateOfBirthMs is int)
        && (!('accountType' in request.resource.data) || request.resource.data.accountType in ['personal', 'business'])
        && (!('businessProfileCreated' in request.resource.data) || request.resource.data.businessProfileCreated is bool);

      allow delete: if isSelf(userId);

      match /tracked_restock_products/{productId} {
        allow read: if isSelf(userId);

        allow create, update: if isSelf(userId)
          && validUserTrackedRestockProductData(request.resource.data, userId);

        allow delete: if isSelf(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isSelf(userId);

        allow create, update: if isSelf(userId)
          && validFcmTokenData(request.resource.data, userId);

        allow delete: if isSelf(userId);
      }

      match /friends/{friendUid} {
        allow read: if canViewSharedCollection(userId);

        allow create: if canCreateFriendDoc(userId, friendUid)
          && request.resource.data.keys().hasOnly(['uid', 'username', 'sinceMs'])
          && request.resource.data.uid == friendUid
          && request.resource.data.username is string
          && request.resource.data.sinceMs is int;

        allow update: if isSelf(userId);
        allow delete: if isSelf(userId)
          || (signedIn() && request.auth.uid == friendUid && resource.data.uid == request.auth.uid);
      }

      match /wishlist/{cardId} {
        allow read: if canViewSharedCollection(userId);
        allow create, update, delete: if isSelf(userId);
      }

      match /pokedex_sets/{setId} {
        allow read: if canViewSharedCollection(userId);
        allow create, update, delete: if isSelf(userId);

        match /cards/{cardId} {
          allow read: if canViewSharedCollection(userId);
          allow create, update, delete: if isSelf(userId);
        }
      }

      match /custom_binders/{binderId} {
        allow read: if canViewSharedCollection(userId);

        allow create, update: if isSelf(userId)
          && validCustomBinderData(request.resource.data, binderId);

        allow delete: if isSelf(userId);

        match /cards/{cardId} {
          allow read: if canViewSharedCollection(userId);

          allow create, update: if isSelf(userId)
            && validCustomBinderCardData(request.resource.data, cardId);

          allow delete: if isSelf(userId);
        }
      }

      match /blocked_users/{blockedUid} {
        allow read: if isSelf(userId);

        allow create, update: if isSelf(userId)
          && validBlockedUserData(request.resource.data, userId, blockedUid);

        allow delete: if isSelf(userId);
      }

      match /community_private_conversations/{conversationId} {
        allow read: if signedIn() && request.auth.uid == userId;

        allow create, update: if canUseCommunity()
          && validPrivateMirrorConversationData(request.resource.data, userId);

        allow delete: if signedIn() && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read: if signedIn() && request.auth.uid == userId;

          allow create: if canUseCommunity()
            && validPrivateMessageData(request.resource.data)
            && getAfter(/databases/$(database)/documents/users/$(userId)/community_private_conversations/$(conversationId)).data.participants is list
            && request.auth.uid in getAfter(/databases/$(database)/documents/users/$(userId)/community_private_conversations/$(conversationId)).data.participants
            && userId in getAfter(/databases/$(database)/documents/users/$(userId)/community_private_conversations/$(conversationId)).data.participants;

          allow update: if false;
          allow delete: if signedIn() && request.auth.uid == userId;
        }
      }
    }

    match /friend_requests/{requestId} {
      allow get: if signedIn()
        && (
          requestId.matches(request.auth.uid + "_to_.*") ||
          requestId.matches(".*_to_" + request.auth.uid) ||
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );

      allow list: if signedIn()
        && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );

      allow create: if signedIn()
        && userExists(request.auth.uid)
        && userExists(request.resource.data.toUid)
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.toName is string
        && request.resource.data.status == "pending"
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && requestId == (request.resource.data.fromUid + "_to_" + request.resource.data.toUid)
        && !areFriends(request.resource.data.fromUid, request.resource.data.toUid)
        && !hasPendingFriendRequestBetween(request.resource.data.fromUid, request.resource.data.toUid)
        && !hasAcceptedFriendRequestBetween(request.resource.data.fromUid, request.resource.data.toUid);

      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.fromName == resource.data.fromName
        && request.resource.data.toName == resource.data.toName
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.updatedAtMs is int
        && (
          request.resource.data.status == "accepted" ||
          request.resource.data.status == "declined"
        );

      allow delete: if signedIn()
        && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );
    }

    match /community_posts/{postId} {
      allow read: if canUseCommunity() || isAdminOrModerator();

      allow create: if canUseCommunity()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.postType is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.contact is string
        && request.resource.data.createdAtMs is int
        && communityCreateHasNoFeaturedFields();

      allow update: if (
          canUseCommunity()
          && request.auth.uid == resource.data.authorId
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAtMs == resource.data.createdAtMs
          && communityFeaturedFieldsUnchanged()
        ) || isAdminOrModerator();

      allow delete: if signedIn()
        && (
          (
            canUseCommunity() &&
            request.auth.uid == resource.data.authorId
          ) ||
          isAdminOrModerator()
        );

      match /replies/{replyId} {
        allow read: if canUseCommunity() || isAdminOrModerator();

        allow create: if canUseCommunity()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.message is string
          && request.resource.data.createdAtMs is int;

        allow update: if canUseCommunity()
          && request.auth.uid == resource.data.authorId;

        allow delete: if signedIn()
          && (
            (
              canUseCommunity() &&
              (
                request.auth.uid == resource.data.authorId ||
                request.auth.uid == get(/databases/$(database)/documents/community_posts/$(postId)).data.authorId
              )
            ) ||
            isAdminOrModerator()
          );
      }
    }

    match /community_private_conversations/{conversationId} {
      allow read: if canUseCommunity()
        && request.auth.uid in resource.data.participants
        && twoAdultParticipants(resource.data.participants);

      allow create: if canUseCommunity()
        && validPrivateConversationData(request.resource.data);

      allow update: if canUseCommunity()
        && request.auth.uid in resource.data.participants
        && validPrivateConversationData(request.resource.data);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canUseCommunity()
          && exists(/databases/$(database)/documents/community_private_conversations/$(conversationId))
          && request.auth.uid in get(/databases/$(database)/documents/community_private_conversations/$(conversationId)).data.participants
          && twoAdultParticipants(get(/databases/$(database)/documents/community_private_conversations/$(conversationId)).data.participants);

        allow create: if canUseCommunity()
          && request.auth.uid in getAfter(/databases/$(database)/documents/community_private_conversations/$(conversationId)).data.participants
          && twoAdultParticipants(getAfter(/databases/$(database)/documents/community_private_conversations/$(conversationId)).data.participants)
          && validPrivateMessageData(request.resource.data);

        allow update, delete: if false;
      }
    }

    match /community_user_ratings/{ratingId} {
      allow read: if canUseCommunity();

      allow create: if canUseCommunity()
        && request.resource.data.keys().hasOnly([
          'sellerId',
          'sellerName',
          'raterId',
          'raterName',
          'stars',
          'comment',
          'createdAtMs',
          'updatedAtMs',
          'sourcePostId',
          'sourcePostTitle'
        ])
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.sellerName is string
        && request.resource.data.raterName is string
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 180
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && (!('sourcePostId' in request.resource.data) || request.resource.data.sourcePostId is string)
        && (!('sourcePostTitle' in request.resource.data) || request.resource.data.sourcePostTitle is string);

      allow update: if canUseCommunity()
        && resource.data.raterId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'sellerId',
          'sellerName',
          'raterId',
          'raterName',
          'stars',
          'comment',
          'createdAtMs',
          'updatedAtMs',
          'sourcePostId',
          'sourcePostTitle'
        ])
        && request.resource.data.raterId == resource.data.raterId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.sellerName is string
        && request.resource.data.raterName is string
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 180
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.updatedAtMs is int
        && (!('sourcePostId' in request.resource.data) || request.resource.data.sourcePostId is string)
        && (!('sourcePostTitle' in request.resource.data) || request.resource.data.sourcePostTitle is string);

      allow delete: if canUseCommunity()
        && resource.data.raterId == request.auth.uid;
    }

    match /community_reports/{reportId} {
      allow read, update, delete: if false;

      allow create: if canUseCommunity()
        && validCommunityReportData(request.resource.data);
    }

    match /chats/{chatId} {
      allow read: if isChatMember(chatId);

      allow create: if canUseCommunity()
        && validChatData(request.resource.data);

      allow update: if isChatMember(chatId)
        && request.resource.data.participants == resource.data.participants
        && validChatData(request.resource.data);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && validChatMessageData(request.resource.data);

        allow update, delete: if false;
      }
    }

    /*
      PUBLIC READ FALLBACK WITH PROTECTED WRITES

      Why this is here:
      - The TCG Shop Map only loaded when Firestore public reads were allowed.
      - This keeps reads open so the map/profile/community data can load.
      - This does NOT open public writes.

      Writes:
      - Client writes are still controlled by the specific create/update/delete
        rules above.
      - The fallback write rule is false, so unknown write paths stay blocked.
    */
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

  }
}
